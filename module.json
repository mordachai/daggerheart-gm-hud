{
  "id": "daggerheart-gm-hud",
  "title": "Daggerheart GM HUD",
  "description": "GM-focused HUD for managing adversaries in the Daggerheart system.",
  "version": "2.0.1",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Gus"
    }
  ],
  "esmodules": [
    "module/daggerheart-gm-hud.mjs"
  ],
  "styles": [
    "styles/dgm-hud.css",
    "styles/dgm-themes.css"
  ],
  "relationships": {
    "systems": [
      {
        "id": "daggerheart",
        "type": "system",
        "compatibility": {}
      }
    ],
    "recommends": [
      {
        "id": "daggerheart-distances",
        "type": "module",
        "reason": "Powers the range-ring/highlight toggle on the adversary HUD's range badge."
      }
    ]
  },
  "url": "https://github.com/mordachai/daggerheart-gm-hud",
  "manifest": "https://github.com/mordachai/daggerheart-gm-hud/releases/latest/download/module.json",
  "download": "https://github.com/mordachai/daggerheart-gm-hud/releases/latest/download/module.zip",
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "templates",
        "styles"
      ]
    }
  }
}
