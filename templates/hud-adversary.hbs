<section class="dgm-hud dgm-hud--layout" data-open="">
  
  {{!-- =============== MAIN CONTAINER =============== --}}
  <div class="dgm-container">

    {{!-- =============== UTILITY BELT =============== --}}
    <div class="dgm-section dgm-section--belt">
      <div class="dgm-belt" role="toolbar" aria-label="Utility belt">
        {{#each utilityBelt.slots}}
        <div class="dgm-belt-slot{{#if id}} filled{{/if}}"
             data-slot-index="{{index}}"
             data-feature-id="{{id}}"
             data-name="{{name}}"
             data-description="{{description}}"
             draggable="{{#if id}}true{{else}}false{{/if}}"
             role="button"
             tabindex="0"
             {{#unless id}}title="Empty slot — right-click to remove"{{/unless}}>
          {{#if img}}
          <img class="dgm-belt-slot-icon" src="{{img}}" alt="{{name}}">
          {{/if}}
        </div>
        {{/each}}
        {{#if utilityBelt.canAddSlot}}
        <div class="dgm-belt-add" role="button" tabindex="0" title="Add slot">
          <i class="fa-solid fa-plus"></i>
        </div>
        {{/if}}
      </div>
    </div>

    {{!-- =============== TOP ROW =============== --}}
    <div class="dgm-top-row">

      {{!-- CORE SECTION - Keep dgm-core class for dragging --}}
      <div class="dgm-section dgm-section--core dgm-core">

        {{!-- Left column: features toggle, reaction roll, fear - in-flow so the panel's real
             width includes them (avoids them floating outside the HUD background) --}}
        <div class="dgm-core-aside">
          {{!-- Features Toggle --}}
          <div class="dgm-features-toggle dgm-tab"
                role="button"
                tabindex="0"
                data-tab="features"
                data-action="toggle-features"
                aria-controls="dgm-features-panel"
                aria-expanded="false"
                title="{{l 'DAGGERHEART.GENERAL.features'}}">
            <span class="dgm-features-icon">F</span>
            {{!-- <span class="dgm-features-icon">{{l 'DAGGERHEART.GENERAL.features'}}</span> --}}
          </div>

          {{!-- Reaction Roll Button --}}
          <div class="dgm-reaction-roll dgm-roll"
                role="button"
                tabindex="0"
                data-action="roll-reaction"
                title="{{l 'DAGGERHEART.GENERAL.reactionRoll'}}">
            <i class="fa-solid fa-reply"></i>
            {{!-- <span class="dgm-button-label">Reaction</span> --}}
          </div>

          {{!-- Fear - Left-click: spend, Right-click: gain --}}
          <div class="dgm-fear dgm-roll"
                role="button"
                tabindex="0"
                data-action="fear-adjust"
                title="{{l 'DAGGERHEART.GENERAL.fear'}}: {{fear}}&#10;Left-click: Spend Fear&#10;Right-click: Gain Fear">
            <i class="fa-solid fa-skull"></i>
            <span class="dgm-fear-value">{{fear}}</span>
          </div>
        </div>

        {{!-- Portrait --}}
        <div class="dgm-portrait-wrapper">
          <div class="dgm-portrait" title="{{adversaryName}} - Tier {{tier}}">
            <img class="dgm-portrait-img" src="{{portrait}}" alt="{{adversaryName}}">
          </div>
        </div>

      </div>
      
      {{!-- RESOURCES SECTION  --}}
      <div class="dgm-section dgm-section--resources">
        {{!-- HP Counter --}}
        <div class="dgm-count dgm-count--hp" title="{{l 'DAGGERHEART.GENERAL.HitPoints.plural'}}">
          <div class="label"><i class="fa-solid fa-heart"></i></div>
          <div class="value" data-bind="hp">{{hp.value}}/{{hp.max}}</div>
        </div>

        {{!-- Stress Counter --}}
        <div class="dgm-count dgm-count--stress" title="{{l 'DAGGERHEART.GENERAL.stress'}}">
          <div class="label"><i class="fa-solid fa-bolt"></i></div>
          <div class="value" data-bind="stress">{{stress.value}}/{{stress.max}}</div>
        </div>

        {{!-- Difficulty Counter --}}
        <div class="dgm-count dgm-count--difficulty" title="{{l 'DAGGERHEART.GENERAL.difficulty'}}">
          <div class="label"><i class="fa-solid fa-shield"></i></div>
          <div class="info" title="Difficulty">{{difficulty}}</div>
        </div>
      </div>

      {{!-- ATTACK SECTION --}}
      <div class="dgm-section dgm-section--attack">
        {{#if primaryAttack}}
        <div class="dgm-attack-container">
          {{!-- Attack Icon - Clickable for attack roll --}}
          <div class="dgm-attack dgm-roll"
              role="button"
              tabindex="0"
              data-action="roll-attack"
              data-attack-id="{{primaryAttack.id}}"
              title="{{l 'DAGGERHEART.GENERAL.Roll.attack'}}: {{primaryAttack.name}} ({{signed primaryAttack.bonus}})">
            <img class="dgm-attack-icon" src="{{primaryAttack.img}}" alt="{{primaryAttack.name}}">

            {{!-- Attack Bonus - Part of attack roll --}}
            <div class="dgm-count dgm-count--attack-bonus dgm-roll" 
                role="button"
                tabindex="0"
                data-action="roll-attack"
                data-attack-id="{{primaryAttack.id}}"
                title="{{l 'DAGGERHEART.ACTIONS.Settings.attackBonus'}} {{signed primaryAttack.bonus}}">
              <div class="dgm-attack-bonus-value">{{signed primaryAttack.bonus}}</div>
            </div>


          </div>

          {{!-- Range - click to toggle Daggerheart: Distances rings for this token --}}
          <div class="dgm-attack-details dgm-roll"
              role="button"
              tabindex="0"
              data-action="create-range-template"
              data-range="{{primaryAttack.range}}"
              title="{{l 'DAGGERHEART.GENERAL.range'}}: {{primaryAttack.rangeName}}&#10;Click: Toggle distance rings">
            {{primaryAttack.rangeShort}}
            <i class="fa-solid fa-bullseye"></i>
          </div>

        </div>

        {{!-- Damage - display only, formula comes straight from the system --}}
        {{#if primaryAttack.damage}}
        <div class="dgm-attack-damage" title="{{l 'DAGGERHEART.GENERAL.damage'}}: {{primaryAttack.damage}}">
          <span class="dgm-attack-damage-value">{{primaryAttack.damage}}</span>
          {{#each primaryAttack.damageIcons}}
          <i class="fa-solid {{icon}}" title="{{label}}"></i>
          {{/each}}
        </div>
        {{/if}}
        {{else}}
        <div class="dgm-attack" title="No attack available">
          <img class="dgm-attack-icon" src="icons/svg/sword.svg" alt="No attack">
          <div class="dgm-attack-info">
            <div class="dgm-attack-name">{{l 'DAGGERHEART.UI.Notifications.attackIsMissing'}}</div>
          </div>
        </div>
        {{/if}}
      </div>

    </div>        

    {{!-- =============== BOTTOM ROW =============== --}}
    {{!-- DAMAGE THRESHOLDS SECTION (Red - Bottom) --}}
    <div class="dgm-section dgm-section--thresholds">
      <div class="dgm-thresholds" aria-label="Damage thresholds">
        <span class="dgm-threshold-chip">{{l 'DAGGERHEART.GENERAL.Damage.minor'}}</span>
        <span class="dgm-threshold-val">{{thresholds.major}}</span>
        <span class="dgm-threshold-chip">{{l 'DAGGERHEART.GENERAL.Damage.major'}}</span>
        <span class="dgm-threshold-val">{{thresholds.severe}}</span>
        <span class="dgm-threshold-chip">{{l 'DAGGERHEART.GENERAL.Damage.severe'}}</span>
        {{#if thresholds.massive}}
        <span class="dgm-threshold-val">{{thresholds.massive}}</span>
        <span class="dgm-threshold-chip">{{l 'DAGGERHEART.GENERAL.Damage.massive'}}</span>
        {{/if}}
      </div>
    </div>

  </div>

  {{!-- =============== FEATURES PANEL (unchanged) =============== --}}
  <div class="dgm-tabwrap">
    <div id="dgm-features-panel" 
         class="dgm-panel dgm-panel--features" 
         data-panel="features" 
         role="dialog" 
         aria-label="Adversary Features">
      
      {{!-- Panel Header --}}
      <div class="dgm-header">
        <details data-sync>
          <summary>
            <header class="dgm-panel-header">
              <div class="dgm-adversary-name">{{adversaryName}}</div>
              <div class="dgm-pills-container">
              {{#if tier}}<span class="dgm-adversary-pills">{{l 'DAGGERHEART.GENERAL.Tiers.singular'}} {{tier}}</span>{{/if}}
              {{#if systemType.label}}<span class="dgm-adversary-pills" title="{{systemType.description}}">{{systemType.label}}</span>{{/if}}
              {{#if size.label}}<span class="dgm-adversary-pills dgm-adversary-pills--size">{{size.label}}</span>{{/if}}
              </div>
            </header>
          </summary>
          <div class="dgm-divider"></div>
          {{#if description}}
          <div class="dgm-section-description">
            {{{description}}}
          </div>
          {{/if}}
          {{#if motivesAndTactics}}
          <div class="dgm-section-content">
            {{{motivesAndTactics}}}
          </div>
          {{/if}}
        </details>
        {{#if experiences}}
        <div class="dgm-section-content dgm-experiences-always">
          <span class="dgm-section-center-title">{{l 'DAGGERHEART.GENERAL.Experience.plural'}}</span>
          {{#each experiences}}
            <div class="dgm-experience">
              {{name}}: +{{value}} {{#if description}}<span>: </span> {{description}}{{/if}} {{#if bonus}}({{signed bonus}}){{/if}}
            </div>
          {{/each}}
        </div>
        {{/if}}
      </div>

      {{!-- Features List with Filter Controls --}}
      <div class="dgm-features-container">
        {{!-- Filter Controls (visible on hover) --}}
        <div class="dgm-features-filter-bar">
          <div class="dgm-filter-buttons">
            <button class="dgm-filter-btn" 
                    data-action="expand-all" 
                    title="Expand all features">
              <i class="fa-solid fa-expand-arrows-alt"></i>
            </button>
            <button class="dgm-filter-btn" 
                    data-action="expand-actions" 
                    title="Expand features with actions">
              <i class="fa-solid fa-bolt"></i>
            </button>
            <button class="dgm-filter-btn" 
                    data-action="expand-passive" 
                    title="Expand passive features">
              <i class="fa-solid fa-book"></i>
            </button>
            <button class="dgm-filter-btn" 
                    data-action="collapse-all" 
                    title="Collapse all features">
              <i class="fa-solid fa-compress-arrows-alt"></i>
            </button>
          </div>
        </div>

        <div class="dgm-divider-center"></div>

        {{!-- Your existing Features List (accordion style) --}}
        <div class="dgm-features-list">
          <ul class="dgm-acc">
            {{#each features}}
            <li class="dgm-acc-item" data-has-actions="{{hasActions}}" data-feature-id="{{id}}" draggable="true">
              <details data-sync>
                <summary>
                  {{!-- Feature Icon (clickable if has actions) --}}
                  <img class="dgm-feature-icon{{#if hasActions}} clickable{{/if}}"
                      src="{{img}}"
                      alt="{{name}}"
                      role="button"
                      tabindex="0"
                      data-action="{{#if hasActions}}feature-exec{{else}}feature-info{{/if}}"
                      data-feature-id="{{id}}"
                      title="{{name}}">

                  {{!-- Feature Name + Form Badge (stacked) --}}
                  <span class="dgm-feature-title">
                    <span class="dgm-feature-name">{{truncate name 25}}</span>
                    {{#if featureFormLabel}}
                    <span class="dgm-feature-form-badge">
                      {{#if featureFormIcon}}<i class="fa-solid {{featureFormIcon}}"></i>{{/if}}
                      {{featureFormLabel}}
                    </span>
                    {{/if}}
                  </span>

                  {{!-- Resource Info (uses, etc.) --}}
                  {{#with (getResourceInfo _item)}}
                  {{#if this}}
                  <span class="dgm-feature-resource">
                    {{#if max}}{{value}}/{{max}}{{else}}{{value}}{{/if}}
                  </span>
                  {{/if}}
                  {{/with}}

                  {{!-- Send to Chat Button --}}
                  <i class="far fa-comment dgm-feature-chat"
                    role="button"
                    tabindex="0"
                    data-action="feature-to-chat"
                    data-feature-id="{{id}}"
                    title="{{l 'DAGGERHEART.UI.Tooltip.sendToChat'}}"></i>
                </summary>

                {{!-- Feature Description (expanded content) --}}
                <div class="dgm-feature-content">
                  {{{description}}}
                </div>

                {{!-- Action Buttons (one per system.actions entry, matching the sheet's chat card) --}}
                {{#if actions.length}}
                <div class="dgm-feature-actions">
                  {{#each actions}}
                  <button type="button"
                          class="dgm-feature-action-btn"
                          data-action="feature-action-use"
                          data-feature-id="{{../id}}"
                          data-action-id="{{id}}">
                    <i class="fa-solid {{icon}}"></i><span>{{name}}</span>
                  </button>
                  {{/each}}
                </div>
                {{/if}}
              </details>
            </li>

            <div class="dgm-divider-left"></div>

            {{else}}
            <li class="dgm-acc-item dgm-empty">{{l "DAGGERHEART.UI.Notifications.featureIsMissing"}}</li>
            {{/each}}
          </ul>
        </div>
      </div>

    </div>
  </div>

  {{!-- =============== PORTRAIT CONTEXT MENU & STATUS GRID =============== --}}

  {{!-- Context Menu --}}
  <div class="dgm-context-menu" id="dgm-context-menu">
    <div class="dgm-context-item" data-action="apply-status">
      <i class="fas fa-magic"></i>
      Toggle Conditions
    </div>
    <div class="dgm-context-item" data-action="toggle-lock" id="dgm-context-lock">
      <i class="fas fa-lock-open"></i>
      <span>Lock Position</span>
    </div>
    <div class="dgm-context-theme" id="dgm-context-theme">
      <div class="dgm-context-item dgm-theme-arrow" role="button" tabindex="0" data-action="theme-prev" aria-label="Previous theme">
        <i class="fas fa-chevron-left"></i>
      </div>
      <span class="dgm-theme-label">Theme: Default</span>
      <div class="dgm-context-item dgm-theme-arrow" role="button" tabindex="0" data-action="theme-next" aria-label="Next theme">
        <i class="fas fa-chevron-right"></i>
      </div>
    </div>
  </div>

  {{!-- Status Effects Grid --}}
  <div class="dgm-status-grid" id="dgm-status-grid">
    <div class="dgm-status-header">
      <i class="fas fa-magic"></i>
      Toggle Condition
    </div>

    {{#if availableConditions}}
      <div class="dgm-status-section">
        <div class="dgm-status-section-title">Daggerheart Conditions</div>
        <div class="dgm-status-icons" data-section="daggerheart">
          {{#each availableConditions}}
            {{#if (eq source "daggerheart")}}
              <div class="dgm-status-icon {{#if isActive}}active{{/if}}"
                   data-condition-id="{{id}}"
                   data-condition-name="{{l name}}"
                   title="{{l name}}">
                <img src="{{img}}" alt="{{l name}}">
              </div>
            {{/if}}
          {{/each}}
        </div>
      </div>

      {{#if showGenericStatusSection}}
      <div class="dgm-status-section">
        <div class="dgm-status-section-title">Generic Conditions</div>
        <div class="dgm-status-icons" data-section="generic">
          {{#each availableConditions}}
            {{#if (eq source "foundry")}}
              <div class="dgm-status-icon {{#if isActive}}active{{/if}}"
                  data-condition-id="{{id}}"
                  data-condition-name="{{l name}}"
                  title="{{l name}}">
                <img src="{{img}}" alt="{{l name}}">
              </div>
            {{/if}}
          {{/each}}
        </div>
      </div>
      {{/if}}
    {{/if}}
  </div>

  {{!-- Tooltip --}}
  <div class="dgm-tooltip" id="dgm-tooltip"></div>

</section>